{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creative-ai-studio.local/agent-broker/task.v1.schema.json",
  "title": "Agent broker task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "prompt_file",
    "workspace",
    "mode",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "parent_task_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "delegation_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "default": 0
    },
    "prompt_file": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["read-only", "workspace-write"]
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["codex", "claude"]
      }
    },
    "allow_fallback": {
      "type": "boolean",
      "default": true
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 3600,
      "default": 900
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 24
    },
    "base_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{40,64}$"
    }
  }
}
