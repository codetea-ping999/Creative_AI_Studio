# Creative AI Studio environment configuration
# Copy this file to .env and modify values as needed

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
API_RELOAD=true

# Database Configuration
DB_PATH=./data/jobs.db

# Models Configuration
MODELS_ROOT=./models
MODELS_MANIFEST_ROOT=./models/manifests

# Output Configuration
OUTPUT_DIR=./outputs
OUTPUT_IMAGE_DIR=./outputs/images
OUTPUT_AUDIO_DIR=./outputs/audio
OUTPUT_TEXT_DIR=./outputs/text

# Local Asset Catalogs
LORA_ROOT=./models/loras

# Optional Semantic Judge
QUALITY_ENABLE_SEMANTIC_JUDGE=false
QUALITY_SEMANTIC_LOCAL_ONLY=true
QUALITY_SEMANTIC_CACHE_DIR=./data/semantic-cache
QUALITY_SEMANTIC_IMAGE_MODEL=openai/clip-vit-base-patch32
QUALITY_SEMANTIC_AUDIO_MODEL=laion/clap-htsat-unfused
QUALITY_SEMANTIC_VIDEO_MODEL=openai/clip-vit-base-patch32
QUALITY_SEMANTIC_IMAGE_MODEL_PATH=
QUALITY_SEMANTIC_AUDIO_MODEL_PATH=
QUALITY_SEMANTIC_VIDEO_MODEL_PATH=
QUALITY_SEMANTIC_ENABLE_IMAGE=true
QUALITY_SEMANTIC_ENABLE_AUDIO=true
QUALITY_SEMANTIC_ENABLE_VIDEO=true
QUALITY_SEMANTIC_VIDEO_BACKEND=image_frames
QUALITY_SEMANTIC_VIDEO_SAMPLE_FRAMES=3

# Logging Configuration
LOG_LEVEL=INFO

# Runtime Configuration
MAX_CACHED_MODELS=1

# Job Lanes
# Concurrency per lane, e.g. "heavy:1,light:1" (image/video/music -> heavy,
# text/TTS/assembly -> light). A single entry (e.g. "default:3") runs all
# media types on one lane. See core/jobs/lanes.py for the full contract.
JOB_LANES=heavy:1,light:1

# Batch Fan-out
# Operator ceiling on how many items one batch may expand to.
BATCH_MAX_ITEMS=64

# Egress Guards (local-only by default)
# Text and audio endpoints are restricted to loopback hosts unless these are
# explicitly set to true. Cloud providers stay disabled until opted into.
ALLOW_REMOTE_TEXT_ENDPOINTS=false
ALLOW_REMOTE_AUDIO_ENDPOINTS=false
ALLOW_CLOUD_PROVIDERS=false

# A provider: "cloud" manifest also needs its own explicit switch, named
# ALLOW_CLOUD_PROVIDER_<MANIFEST_ID> (id uppercased, non-alphanumerics -> "_").
# Example for the disabled-by-default seam at
# models/manifests/audio/cloud-tts-example.json:
# ALLOW_CLOUD_PROVIDER_CLOUD_TTS_EXAMPLE=false

# API key for a local OpenAI-compatible text endpoint, when it requires one.
# Referenced by name from the manifest; never write keys into a manifest.
LOCAL_TEXT_ENDPOINT_API_KEY=

# API key for the example cloud TTS seam, when enabled. Referenced by name
# from the manifest (default_params.api_key_env); never write keys into a
# manifest.
CLOUD_TTS_EXAMPLE_API_KEY=

# Optional: Model-specific settings
# STABLE_DIFFUSION_MODEL_ID=runwayml/stable-diffusion-v1-5
# DEVICE=cpu  # or 'cuda', 'mps' for GPU acceleration
